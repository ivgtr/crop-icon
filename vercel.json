{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "yarn install --frozen-lockfile --non-interactive --production=false",
  "builds": [
    { "src": "api/index.ts", "use": "@vercel/node", "config": { "maxDuration": 15 } }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/index.ts" },
    { "source": "/api", "destination": "/api/index.ts" },
    { "source": "/api/", "destination": "/api/index.ts" },
    { "source": "/index.html", "destination": "/api/index.ts" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" }
  ] }]
}
