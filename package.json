{
  "name": "crop-icon",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivgtr/crop-icon.git"
  },
  "engines": {
    "node": "24.x",
    "npm": "12.0.2"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run build && node build/scripts/dev.js",
    "build": "npm run generate:editor && tsc",
    "vercel-build": "npm run build",
    "typecheck": "npm run generate:editor && tsc --noEmit",
    "generate:editor": "tsc -p tsconfig.editor.json && tsc -p tsconfig.tools.json && esbuild api/_lib/editor/index.ts --tsconfig=tsconfig.editor.json --bundle --platform=browser --format=iife --target=es2022 --charset=ascii --legal-comments=none --minify --outfile=build/editor.js --metafile=build/editor.meta.json && node build/scripts/build.js",
    "test": "npm run build && node --test build/tests/*.test.js",
    "check": "npm run test",
    "test:e2e": "tsc -p tsconfig.e2e.json && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
