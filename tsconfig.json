{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "allowJs": false, "checkJs": false,
    "outDir": "build", "rootDir": ".",
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true, "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "lib": ["ES2022"], "types": ["node"], "typeRoots": ["./node_modules/@types"]
  },
  "include": ["api/**/*.ts", "scripts/**/*.ts", "tests/*.ts"],
  "exclude": ["node_modules", "build", "api/_lib/editor"]
}
